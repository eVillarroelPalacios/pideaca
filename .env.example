# Plantilla de producción — PideAca en https://pideaca.com (raíz del dominio).
# Copiar como `.env` en el servidor y completar los valores marcados con << >>.
# Generar APP_KEY en el servidor con: php artisan key:generate --force

APP_NAME=PideAca
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://pideaca.com
# No definir ASSET_URL en raíz: los activos heredan APP_URL.

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Mercado Pago: cuenta recaudadora (cobro al cliente) + OAuth Marketplace
# (split automático al vendedor). Sin MP_ACCESS_TOKEN el checkout informa
# "no disponible". Sin MP_APP_ID/MP_CLIENT_SECRET no hay conexión de vendedores.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=
MP_APP_ID=
MP_CLIENT_SECRET=
# MP_BASE_URL=https://api.mercadopago.com

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=<<HOST-PG-DEL-PANEL>>
DB_PORT=5432
DB_DATABASE=<<BASE-PG>>
DB_USERNAME=<<USUARIO-PG>>
DB_PASSWORD=<<CLAVE-PG>>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=<<HOST-SMTP>>
MAIL_PORT=587
MAIL_USERNAME=<<USUARIO-SMTP>>
MAIL_PASSWORD=<<CLAVE-SMTP>>
MAIL_FROM_ADDRESS="info@pideaca.com"
MAIL_FROM_NAME="PideAca"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Suscripciones: canal de cobro. "manual" deja el ciclo en PENDING y el
# comercio lo confirma (efectivo o transferencia). "webhook" delega el cobro a
# una pasarela y hay que completar URL y token.
SUBSCRIPTIONS_BILLING_GATEWAY=manual
SUBSCRIPTIONS_BILLING_URL=
SUBSCRIPTIONS_BILLING_TOKEN=
SUBSCRIPTIONS_BILLING_TIMEOUT=15
SUBSCRIPTIONS_PAUSE_ON_FAILURE=true

SERVICE_GROUP_ID=2
GROUP_STATUS_ACTIVE_ID=1
GROUP_STATUS_INACTIVE_ID=2
REGISTRABLE_TYPE_IDS=2,3,4

FAST_DELIVERY_FEE=3500.00
DRIVER_MIN_WITHDRAWAL=1000.00

# App Android propia (Fase 3, $0 sin EAS Update).
# El endpoint publico /api/mobile/v1/app/version expone estos valores y la
# app instalada los compara con los suyos para avisar la actualizacion.
# APP_ANDROID_APK_URL=https://pideaca.com/apk/pideaca-v1.0.0.apk
APP_ANDROID_VERSION_NAME=1.0.0
APP_ANDROID_VERSION_CODE=1
# true = la version instalada debe actualizar para seguir operando.
APP_ANDROID_MANDATORY=false
APP_ANDROID_RELEASE_NOTES=
