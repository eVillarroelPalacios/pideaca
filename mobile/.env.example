# URL base del API móvil.
#
# Si NO definís esta variable, la app la deduce sola:
# - En el celular/emulador usa la misma IP de tu PC que Expo/Metro ya conoce.
# - En web usa el host del navegador.
#
# Descomentá y ajustá solo si el API no está en /pideaca o usa otro puerto.
#
# XAMPP/Apache (celular físico, misma red Wi-Fi):
# EXPO_PUBLIC_API_URL=http://192.168.1.10/pideaca/api/mobile/v1
#
# php artisan serve (desde el emulador Android):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api/mobile/v1
